#!/bin/zsh

VERBOSE=false

ORGIFS="${IFS}"
IFS="${DELIMITER_ENDL}"

INPUT_STDIN=($(get-stdin &))

SCRIPT="${0##*/}"
BROWSER=$(capitalcase ${SCRIPT//[_-]/ })

[[ $# -gt 0 ]] &&  startsWithDash "${1}" && [[ "${1}" = '-v' ]] && { VERBOSE=true; shift }


[[ -n "${INPUT_STDIN}" ]] && URL="${INPUT_STDIN}" || URL="${1}"

if ${VERBOSE}
then
    ecko "BROWSER=$BROWSER" 15 88
    ecko "\$SHLVL ${ARROWS[1]} $SHLVL" 88 15
    ecko "URL = ${URL}" 18 118
fi

open -a /Applications/${BROWSER}.app "${URL}"
